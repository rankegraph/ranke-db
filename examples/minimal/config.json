{
  "signer": {
    "type": "inmemory",
    "key": "env(RANKE_SIGNER_KEY)"
  },
  "storage": {
    "type": "stack",
    "layers": [
      {
        "type": "mem"
      }
    ]
  },
  "sequencer": {
    "type": "dev",
    "seed": "minimal-example",
    "founder": "env(RANKE_FOUNDER_PUBKEY)"
  },
  "accounts": {
    "ops": {
      "grants": [
        "CR *",
        "C $branches",
        "R $branches",
        "R $archive",
        "R $universe"
      ]
    },
    "admin": {
      "grants": [
        "CR *",
        "C $branches",
        "R $branches",
        "R $archive",
        "R $universe"
      ]
    }
  },
  "endpoints": [
    {
      "transport": {
        "type": "rest",
        "addr": ":8080",
        "allowedOrigins": "http://localhost:5173, http://127.0.0.1:5173, http://localhost:4173"
      },
      "auth": [
        {
          "type": "noauth",
          "subject": "ops"
        }
      ],
      "admit": [
        "ops"
      ]
    },
    {
      "transport": {
        "type": "rest",
        "addr": "unix://./run/admin.sock",
        "mode": "0660"
      },
      "auth": [
        {
          "type": "noauth",
          "subject": "admin"
        }
      ],
      "admit": [
        "admin"
      ]
    }
  ]
}
